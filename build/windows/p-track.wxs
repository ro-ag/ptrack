<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user p-track installer (WiX Toolset 3.14).

  Installs into %LOCALAPPDATA%\Programs\p-track and never asks for
  administrator rights: the package is per-user scope with limited
  privileges, every key path lives under HKCU, and nothing is written outside
  the user profile. It adds the install folder to the user's PATH so `ptrack`
  works in any new terminal, and a Start menu entry that opens the desktop
  workspace through the console-free p-track.exe launcher.

  Built by build/windows/build-msi.ps1, which supplies:
    Version     release version (X.Y.Z)
    BinDir      folder holding ptrack.exe and p-track.exe for this arch
    DocsDir     folder holding README.md and LICENSE
    IconPath    product icon (.ico)
    LicenseRtf  license text for the consent page
    BannerBmp / DialogBmp  installer artwork
  and the -arch switch (x64 or arm64) for the package platform.

  The UpgradeCode and component GUIDs are frozen: changing any of them breaks
  upgrades from every release already installed.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="p-track"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="ro-ag"
           UpgradeCode="3E406A5A-2CA5-4274-AA3C-8B3AEE4F8317">
    <!-- Windows Installer 5.0 is required for ARM64 packages. -->
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             InstallPrivileges="limited"
             Description="p-track $(var.Version)"
             Comments="Observe agent work, keep the plan, pass the context." />

    <!-- Same-version upgrades replace the installed copy: a rebuilt package of
         one version must not install beside it as a second product. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of p-track is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ProductIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ro-ag/ptrack" />
    <Property Id="ARPHELPLINK" Value="https://ro-ag.github.io/ptrack/help/" />
    <!-- WixUI_Minimal already sets ARPNOMODIFY: there is nothing to modify. -->

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="p-track" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="ProgramFiles" Guid="F44A3B9F-A7E0-4118-A524-B0D1A05C7815">
        <File Id="PtrackExe" Name="ptrack.exe" Source="$(var.BinDir)\ptrack.exe" />
        <File Id="LauncherExe" Name="p-track.exe" Source="$(var.BinDir)\p-track.exe" />
        <File Id="ReadmeFile" Name="README.md" Source="$(var.DocsDir)\README.md" />
        <File Id="LicenseFile" Name="LICENSE" Source="$(var.DocsDir)\LICENSE" />
        <!-- Per-user components need an HKCU key path (ICE38). The updater
             also reads InstallDir to recognize an installed copy. -->
        <RegistryValue Root="HKCU"
                       Key="Software\ro-ag\p-track"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLDIR]"
                       KeyPath="yes" />
        <Environment Id="UserPath"
                     Name="PATH"
                     Value="[INSTALLDIR]"
                     Action="set"
                     Part="last"
                     System="no"
                     Permanent="no" />
        <RemoveFolder Id="RemoveInstallDir" Directory="INSTALLDIR" On="uninstall" />
        <RemoveFolder Id="RemoveUserPrograms" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuEntry" Guid="CC5AC4F9-86C3-4E88-89AA-C895FFDB975D">
        <Shortcut Id="StartMenuShortcut"
                  Name="p-track"
                  Description="Open the p-track project workspace"
                  Target="[INSTALLDIR]p-track.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="ProductIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\ro-ag\p-track"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="p-track" Level="1" Absent="disallow">
      <ComponentRef Id="ProgramFiles" />
      <ComponentRef Id="StartMenuEntry" />
    </Feature>

    <!-- Welcome and license, install, then an optional "Open p-track". -->
    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open p-track" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#LauncherExe]" />
    <CustomAction Id="OpenPtrack" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="OpenPtrack">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>
  </Product>
</Wix>
